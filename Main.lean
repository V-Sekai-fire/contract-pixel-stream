import PixelStream.Vectors

open PixelStream

private def hex (bs : List UInt8) : String :=
  if bs.isEmpty then "-" else String.join (bs.map (fun b => s!"{b.toNat}.")) 

private def emitTrace (t : Trace) : String :=
  let head := s!"TRACE {t.name} {t.capacity}\n"
  let frags := String.join (t.fragments.map (fun f =>
    s!"FRAG {f.frameSeq} {f.fragIndex} {f.fragCount} {f.echoedInputSeq} {hex f.payload}\n"))
  let outs := String.join (t.expect.map (fun f =>
    s!"EXPECT {f.frameSeq} {f.echoedInputSeq} {hex f.payload}\n"))
  head ++ frags ++ outs ++ "END\n"

def main : IO Unit := do
  IO.println "# pixel-stream conformance vectors, generated by `lake exe wire_vectors`"
  for t in corpus do
    IO.print (emitTrace t)
